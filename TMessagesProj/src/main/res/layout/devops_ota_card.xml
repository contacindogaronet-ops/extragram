<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="?attr/background">

    <!-- Card Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/grey_card_background"
        android:padding="16dp"
        android:elevation="1dp">

        <TextView
            android:id="@+id/ota_title_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Rilis Terbaru: v12.4.0"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="?attr/windowBackgroundWhiteBlackText"/>

        <TextView
            android:id="@+id/ota_desc_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="APK siap diunduh dari repository."
            android:textSize="14sp"
            android:textColor="?attr/windowBackgroundWhiteGrayText"/>

        <TextView
            android:id="@+id/ota_changelog_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="• Catatan Rilis / Changelog:\nAutomated OTA Release for DevOps & Engine Control Build."
            android:textSize="13sp"
            android:textColor="?attr/windowBackgroundWhiteGrayText"/>

        <!-- Tombol Aksi ala Telegram -->
        <FrameLayout
            android:id="@+id/ota_action_button"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/profile_button_bg"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="Periksa Pembaruan / Unduh APK"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@drawable/featured_button_text_color"/>
        </FrameLayout>

    </LinearLayout>
</LinearLayout>
